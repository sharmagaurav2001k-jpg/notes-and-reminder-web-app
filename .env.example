# Database connection string (Supabase / PostgreSQL)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# NextAuth Configuration
NEXTAUTH_SECRET="your_nextauth_secret_key"
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp Business Platform (Meta Cloud API)
# Get from Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_WABA_ID="your_whatsapp_business_account_id"
WHATSAPP_ACCESS_TOKEN="your_meta_system_user_or_temporary_token"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="smart_notes_verify_token_2026"
WHATSAPP_API_VERSION="v21.0"

# Database connection string (Supabase / PostgreSQL)
DATABASE_URL="postgresql://user:***@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:***@host:5432/postgres"

# NextAuth Configuration
NEXTAUTH_SECRET="your_nextauth_key"
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp Business Platform (Meta Cloud API)
# Get from Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_WABA_ID="your_whatsapp_business_account_id"
WHATSAPP_ACCESS_TOKEN="your_access_token"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="smart_remind_2026"
WHATSAPP_API_VERSION="v21.0"

# Cron Worker Security (required in production)
CRON_SECRET="generate_a_random_string_here"

# ─── Supabase Full Integration ───────────────────────────────────────

# Supabase Project URL (found in Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Supabase Anon Key (public, safe for browser — respects RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key"

# Supabase Service Role Key (server-only! full access, bypasses RLS)
# NEVER expose this in the browser
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# ─── OAuth Providers (optional — enable Google/GitHub login) ────────

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

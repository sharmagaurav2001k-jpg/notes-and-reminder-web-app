# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage

# Next.js build output
/.next/
/out/
/build
/dist

# Environment variables
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
# But track example env file
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Logs and Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Secrets, certificates, and credentials
*.pem
*.key
*.crt
*.cert

# Database / SQLite local dev files
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
*.db-journal

# AI Agent / IDE cache (optional)
.gemini/
